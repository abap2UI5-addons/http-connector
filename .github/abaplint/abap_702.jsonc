{
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abaplint/deps",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // abaplint/deps has no ABAP Unit API - the test class needs
      // cl_abap_unit_assert. Not from steampunk-2305-api-intersect-702: the
      // core lints with that one, and the rename takes the first entry of a
      // URL, so these two files would hide the rest of it there
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/aunit",
      "files": "/src/{cl_abap_unit_assert.clas,if_aunit_constants.intf}.abap"
    },
    {
      // the downported abap2UI5 (branch 702 is generated from main)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "uncaught_exception": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
